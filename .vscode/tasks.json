{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Gradle: assembleDebug",
            "type": "shell",
            "command": "C:\\Android\\gradle\\gradle-8.9\\bin\\gradle.bat",
            "args": ["assembleDebug", "--no-daemon"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "JAVA_HOME": "C:\\Program Files\\Java\\jdk-17",
                    "ANDROID_HOME": "C:\\Android\\Sdk"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ADB: install",
            "type": "shell",
            "command": "C:\\Android\\Sdk\\platform-tools\\adb.exe",
            "args": ["install", "-r", "app/build/outputs/apk/debug/app-debug.apk"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Gradle: assembleDebug",
            "problemMatcher": []
        },
        {
            "label": "ADB: install + launch",
            "type": "shell",
            "command": "C:\\Android\\Sdk\\platform-tools\\adb.exe",
            "args": ["shell", "am", "start", "-n", "com.kyf778.yishi/.MainActivity"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ADB: install",
            "problemMatcher": []
        },
        {
            "label": "ADB: logcat",
            "type": "shell",
            "command": "C:\\Android\\Sdk\\platform-tools\\adb.exe",
            "args": ["logcat", "-s", "yishi:*", "AndroidRuntime:E"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        }
    ]
}