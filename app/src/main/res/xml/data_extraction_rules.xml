<?xml version="1.0" encoding="utf-8"?>
<!--
  不参与系统云备份与设备迁移。

  这个 App 是纯本地工具：数据属于用户自己的手机，不需要上云。
  只要正常覆盖更新（install -r）就不会丢数据——Android 覆盖安装
  保留 /data/data/<包名>/ 下全部内容，跟这个文件无关。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
